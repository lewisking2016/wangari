# ============================================
# Wangari — Production Environment Variables
# ============================================
# Copy these into Vercel Dashboard → Settings → Environment Variables
# Or use: vercel env add <name> <value>

# ── Database (PostgreSQL) ──
# Option A: Neon (recommended — free tier, fast, scales)
#   1. Sign up at https://neon.tech
#   2. Create project → copy connection string
#   3. Paste below
# Option B: VPS PostgreSQL (requires exposing port)
#   postgresql://wangari:PASSWORD@YOUR_VPS_IP:5432/wangari_db?schema=public
DATABASE_URL=

# ── NextAuth.js ──
NEXTAUTH_URL=https://wangari.imeantech.com
NEXTAUTH_SECRET=   # Generate: openssl rand -base64 32

# ── Google OAuth ──
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Add these redirect URIs:
#    - https://wangari.imeantech.com/api/auth/callback/google
#    - https://wangari-*.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Paystack (use keys from Paystack Dashboard → Settings → API Keys) ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=KES

# ── Paystack Webhook URL ──
# Set this in Paystack Dashboard → Settings → Webhook URL:
# https://wangari.imeantech.com/api/paystack/webhook
