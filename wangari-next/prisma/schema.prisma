generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  phone           String?   @unique
  password        String?
  googleId        String?   @unique @map("google_id")
  avatar          String?
  role            String    @default("farm_owner")
  profileComplete Boolean   @default(false) @map("profile_complete")
  emailVerified   DateTime? @map("email_verified")
  trialStartsAt   DateTime? @map("trial_starts_at")
  trialEndsAt     DateTime? @map("trial_ends_at")
  selectedHubs    String?   @map("selected_hubs")
  resetToken      String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  farms        FarmMember[]
  ownedFarms   Farm[]
  flocks       Flock[]
  transactions Transaction[]
  sales        Sale[]
  workers      Worker[]
  auditLogs    AuditLog[]
  crops        Crop[]
  verifications VerificationCode[]
  subscriptions Subscription[]

  @@map("users")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  code      String
  purpose   String   @default("email_verification")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

model Subscription {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  plan          String
  planName      String   @map("plan_name")
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("active")
  reference     String?
  startsAt      DateTime @default(now()) @map("starts_at")
  expiresAt     DateTime @map("expires_at")
  renewedAt     DateTime? @map("renewed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?  @unique
  location  String?
  county    String?
  farmType  String?  @map("farm_type")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner        User           @relation(fields: [ownerId], references: [id])
  members      FarmMember[]
  flocks       Flock[]
  transactions Transaction[]
  inventory    Inventory[]
  customers    Customer[]
  sales        Sale[]
  workers      Worker[]
  feedRecipes  FeedRecipe[]
  weatherCache WeatherCache[]
  dailyProductions DailyProduction[]
  credits Credit[]
  attendances Attendance[]
  auditLogs AuditLog[]
  settings     FarmSetting[]
  workerTasks   WorkerTask[]
  workerLogs    WorkerLog[]
  zktecoDevices ZKTecoDevice[]
  zktecoLogs    ZKTecoLog[]
  breeding Breeding[]
  crops Crop[]
  cropHarvests     CropHarvest[]
  cropHealth       CropHealth[]
  cropApplications CropApplication[]
  invoices Invoice[]

  @@map("farms")
}

model FarmMember {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  farmId   Int    @map("farm_id")
  role     String @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([userId, farmId])
  @@map("farm_members")
}

model Flock {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String
  breed        String?
  initialCount Int       @map("initial_count")
  currentCount Int       @map("current_count")
  mortality    Int       @default(0)
  hatchDate    DateTime? @map("hatch_date")
  status       String    @default("active")
  type         String?   @default("layers")

  // Extended fields
  category         String?   @default("poultry")
  purpose          String?
  gender           String?
  genderRatio      String?   @map("gender_ratio")
  location         String?
  source           String?
  supplierContact  String?   @map("supplier_contact")
  costPerAnimal    Decimal?  @map("cost_per_animal") @db.Decimal(10, 2)
  totalInvestment  Decimal?  @map("total_investment") @db.Decimal(12, 2)
  targetMarket     String?   @map("target_market")
  feedType         String?   @map("feed_type")
  feedSupplier     String?   @map("feed_supplier")
  feedCostPerMonth Decimal?  @map("feed_cost_per_month") @db.Decimal(10, 2)
  vetName          String?   @map("vet_name")
  vetPhone         String?   @map("vet_phone")
  healthOnArrival  String?   @map("health_on_arrival")
  insurancePolicy  String?   @map("insurance_policy")
  photoUrl         String?   @map("photo_url")
  expectedYield    String?   @map("expected_yield")
  expectedRevenue  Decimal?  @map("expected_revenue") @db.Decimal(12, 2)
  expectedWeight   String?   @map("expected_weight")
  notes            String?

  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  production   DailyProduction[]
  vaccinations Vaccination[]
  breeding     Breeding[]

  @@map("flocks")
}

model DailyProduction {
  id              Int      @id @default(autoincrement())
  flockId         Int      @map("flock_id")
  farmId          Int      @map("farm_id")
  date            DateTime @db.Date
  eggsCollected   Int      @default(0) @map("eggs_collected")
  milkCollected   Decimal  @default(0) @map("milk_collected") @db.Decimal(10, 2)
  mortality       Int      @default(0)
  feedUsed        Decimal  @default(0) @map("feed_used") @db.Decimal(10, 2)
  avgWeight       Decimal? @map("avg_weight") @db.Decimal(10, 2)
  weightGain      Decimal? @map("weight_gain") @db.Decimal(10, 2)
  waterUsed       Decimal? @map("water_used") @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@unique([flockId, date])
  @@map("daily_production")
}

model Breeding {
  id            Int       @id @default(autoincrement())
  flockId       Int       @map("flock_id")
  farmId        Int       @map("farm_id")
  sireName      String?   @map("sire_name")
  sireBreed     String?   @map("sire_breed")
  damName       String?   @map("dam_name")
  damBreed      String?   @map("dam_breed")
  matingDate    DateTime  @map("mating_date")
  expectedBirth DateTime? @map("expected_birth")
  actualBirth   DateTime? @map("actual_birth")
  offspringCount Int?     @map("offspring_count")
  offspringAlive Int?     @map("offspring_alive")
  method        String?
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@map("breeding_records")
}

model Crop {
  id            Int       @id @default(autoincrement())
  farmId        Int       @map("farm_id")
  name          String
  cropType      String    @map("crop_type")
  variety       String?
  areaAcres     Decimal?  @map("area_acres") @db.Decimal(10, 2)
  plantingDate  DateTime? @map("planting_date")
  expectedHarvest DateTime? @map("expected_harvest")
  status        String    @default("active")
  location      String?
  soilType      String?   @map("soil_type")
  irrigation    String?
  notes         String?
  createdBy     Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  farm      Farm          @relation(fields: [farmId], references: [id])
  creator   User?         @relation(fields: [createdBy], references: [id])
  harvests     CropHarvest[]
  health       CropHealth[]
  applications CropApplication[]

  @@map("crops")
}

model CropHarvest {
  id            Int       @id @default(autoincrement())
  cropId        Int       @map("crop_id")
  farmId        Int       @map("farm_id")
  date          DateTime  @db.Date
  quantityKg    Decimal   @map("quantity_kg") @db.Decimal(10, 2)
  quality       String?
  soldQuantity  Decimal?  @map("sold_quantity") @db.Decimal(10, 2)
  salePrice     Decimal?  @map("sale_price") @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_harvests")
}

model CropHealth {
  id            Int       @id @default(autoincrement())
  cropId        Int       @map("crop_id")
  farmId        Int       @map("farm_id")
  date          DateTime  @db.Date
  issueType     String    @map("issue_type")
  description   String
  severity      String    @default("low")
  treatment     String?
  treatedDate   DateTime? @map("treated_date")
  outcome       String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_health")
}

model CropApplication {
  id            Int       @id @default(autoincrement())
  cropId        Int       @map("crop_id")
  farmId        Int       @map("farm_id")
  date          DateTime  @db.Date
  type          String
  productName   String    @map("product_name")
  quantity      Decimal   @db.Decimal(10, 2)
  unit          String
  cost          Decimal?  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_applications")
}

model Vaccination {
  id            Int       @id @default(autoincrement())
  flockId       Int       @map("flock_id")
  vaccineName   String    @map("vaccine_name")
  scheduledDate DateTime  @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])

  @@map("vaccinations")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  type          String
  category      String?
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  date          DateTime @db.Date
  paymentMethod String?  @map("payment_method")
  reference     String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm Farm  @relation(fields: [farmId], references: [id])
  user User? @relation(fields: [createdBy], references: [id])

  @@map("transactions")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  itemName    String   @map("item_name")
  category    String?
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @default("bags")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(10, 2)
  reorderLevel Int     @default(0) @map("reorder_level")
  supplier    String?
  expiryDate  DateTime? @map("expiry_date")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  farm  Farm           @relation(fields: [farmId], references: [id])
  logs  InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  inventoryId    Int      @map("inventory_id")
  changeType     String   @map("change_type")
  quantityChange Decimal  @map("quantity_change") @db.Decimal(10, 2)
  reason         String?
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("inventory_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  name        String
  phone       String?
  email       String?
  address     String?
  totalCredit Decimal  @default(0) @map("total_credit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  farm    Farm      @relation(fields: [farmId], references: [id])
  sales   Sale[]
  credits Credit[]
  invoices Invoice[]

  @@map("customers")
}

model Sale {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  customerId    Int?     @map("customer_id")
  items         Json
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentStatus String   @default("paid") @map("payment_status")
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  saleDate      DateTime @default(now()) @map("sale_date")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm     Farm       @relation(fields: [farmId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  user     User?      @relation(fields: [createdBy], references: [id])
  credits  Credit[]
  invoices Invoice[]

  @@map("sales")
}

model Credit {
  id         Int      @id @default(autoincrement())
  saleId     Int?     @map("sale_id")
  customerId Int      @map("customer_id")
  farmId     Int      @map("farm_id")
  amountOwed Decimal  @map("amount_owed") @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate    DateTime? @map("due_date")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")

  sale     Sale?    @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  farm     Farm     @relation(fields: [farmId], references: [id])

  @@map("credits")
}

model Invoice {
  id             Int      @id @default(autoincrement())
  farmId         Int      @map("farm_id")
  saleId         Int?     @map("sale_id")
  customerId     Int?     @map("customer_id")
  invoiceNumber  String   @map("invoice_number")
  items          Json
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  amountPaid     Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus  String   @default("pending") @map("payment_status")
  dueDate        DateTime? @map("due_date")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  farm     Farm      @relation(fields: [farmId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Worker {
  id        Int       @id @default(autoincrement())
  farmId    Int       @map("farm_id")
  name      String
  phone     String?
  role      String?
  pin       String?
  dailyWage Decimal?  @map("daily_wage") @db.Decimal(10, 2)
  status    String    @default("active")
  hiredDate DateTime? @map("hired_date")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  farm       Farm         @relation(fields: [farmId], references: [id])
  creator    User?        @relation(fields: [createdBy], references: [id])
  attendance Attendance[]
  zktecoLogs ZKTecoLog[]
  tasks      WorkerTask[]
  logs       WorkerLog[]

  @@map("workers")
}

model WorkerTask {
  id          Int       @id @default(autoincrement())
  farmId      Int       @map("farm_id")
  workerId    Int?      @map("worker_id")
  title       String
  description String?
  category    String    @default("general")
  dueDate     DateTime  @default(now()) @map("due_date") @db.Date
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  farm   Farm    @relation(fields: [farmId], references: [id])
  worker Worker? @relation(fields: [workerId], references: [id])

  @@map("worker_tasks")
}

model WorkerLog {
  id        Int      @id @default(autoincrement())
  farmId    Int      @map("farm_id")
  workerId  Int      @map("worker_id")
  type      String
  quantity  Decimal  @default(0) @db.Decimal(10, 2)
  unit      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  farm   Farm   @relation(fields: [farmId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_logs")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  workerId  Int      @map("worker_id")
  farmId    Int      @map("farm_id")
  date      DateTime @db.Date
  checkIn   String?  @map("check_in")
  checkOut  String?  @map("check_out")
  status    String   @default("present")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id])
  farm   Farm   @relation(fields: [farmId], references: [id])

  @@map("attendance")
}

model FeedRecipe {
  id         Int      @id @default(autoincrement())
  farmId     Int      @map("farm_id")
  name       String
  ingredients Json?
  costPerBag Decimal? @map("cost_per_bag") @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@map("feed_recipes")
}

model WeatherCache {
  id           Int      @id @default(autoincrement())
  farmId       Int?     @map("farm_id")
  location     String   @default("default")
  date         DateTime @db.Date
  tempMax      Decimal? @map("temperature_max") @db.Decimal(5, 2)
  tempMin      Decimal? @map("temperature_min") @db.Decimal(5, 2)
  rainfallMm   Decimal? @map("rainfall_mm") @db.Decimal(5, 2)
  weatherCode  String?  @map("weather_code")
  forecastJson Json?    @map("forecast_json")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm? @relation(fields: [farmId], references: [id])

  @@unique([location, date])
  @@map("weather_cache")
}

model FarmSetting {
  id           Int      @id @default(autoincrement())
  farmId       Int      @map("farm_id")
  settingKey   String   @map("setting_key")
  settingValue String?  @map("setting_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, settingKey])
  @@map("farm_settings")
}

model ZKTecoDevice {
  id           Int      @id @default(autoincrement())
  farmId       Int      @map("farm_id")
  serialNumber String   @map("serial_number")
  name         String?
  model        String?
  status       String   @default("active")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id])
  logs ZKTecoLog[]

  @@unique([farmId, serialNumber])
  @@map("zkteco_devices")
}

model ZKTecoLog {
  id           Int      @id @default(autoincrement())
  deviceId     Int      @map("device_id")
  farmId       Int      @map("farm_id")
  deviceUserId String   @map("device_user_id")
  workerId     Int?     @map("worker_id")
  timestamp    DateTime
  verifyType   String?  @map("verify_type")
  attendanceId String?  @map("attendance_id")
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at")

  device ZKTecoDevice @relation(fields: [deviceId], references: [id])
  farm   Farm         @relation(fields: [farmId], references: [id])
  worker Worker?      @relation(fields: [workerId], references: [id])

  @@unique([deviceId, attendanceId])
  @@map("zkteco_logs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  farmId     Int?     @map("farm_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])
  farm Farm? @relation(fields: [farmId], references: [id])

  @@map("audit_log")
}
