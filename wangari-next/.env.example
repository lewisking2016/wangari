# Wangari Next.js Frontend — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Backend API ───────────────────────────────────────────
# VPS backend URL — used by api-client to call the backend directly
NEXT_PUBLIC_BACKEND_URL=https://api.wangari.imeantech.com

# ─── App URL ───────────────────────────────────────────────
NEXTAUTH_URL=https://wangari.imeantech.com

# ─── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=

# ─── Database (Prisma) — only needed if running API routes locally ──
DATABASE_URL=
