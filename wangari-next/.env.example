# Wangari Next.js Frontend — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── App URL ───────────────────────────────────────────────
# Canonical URL for NextAuth callbacks, Paystack redirects, etc.
NEXTAUTH_URL=https://wangari.imeantech.com

# ─── NextAuth Secret ───────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Google OAuth ──────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Paystack ──────────────────────────────────────────────
# Get your keys from: https://dashboard.paystack.com/settings
PAYSTACK_SECRET_KEY=

# ─── Database (Prisma) ────────────────────────────────────
# Format: mysql://user:password@host:port/database
DATABASE_URL=
