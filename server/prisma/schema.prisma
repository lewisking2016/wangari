generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      String   @default("farm_owner")
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farms        FarmMember[]
  ownedFarms   Farm[]
  flocks       Flock[]
  transactions Transaction[]
  sales        Sale[]
  workers      Worker[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  county    String?
  farmType  String?  @map("farm_type")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner        User           @relation(fields: [ownerId], references: [id])
  members      FarmMember[]
  flocks       Flock[]
  transactions Transaction[]
  inventory    Inventory[]
  customers    Customer[]
  sales        Sale[]
  workers      Worker[]
  feedRecipes  FeedRecipe[]
  weatherCache WeatherCache[]
  dailyProductions DailyProduction[]
  credits Credit[]
  attendances Attendance[]
  auditLogs AuditLog[]
  settings     FarmSetting[]

  @@map("farms")
}

model FarmMember {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  farmId   Int    @map("farm_id")
  role     String @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([userId, farmId])
  @@map("farm_members")
}

model Flock {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String
  breed        String?
  initialCount Int       @map("initial_count")
  currentCount Int       @map("current_count")
  mortality    Int       @default(0)
  hatchDate    DateTime? @map("hatch_date")
  status       String    @default("active")
  type         String?   @default("layers")
  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  production   DailyProduction[]
  vaccinations Vaccination[]

  @@map("flocks")
}

model DailyProduction {
  id            Int    @id @default(autoincrement())
  flockId       Int    @map("flock_id")
  farmId        Int    @map("farm_id")
  date          DateTime @db.Date
  eggsCollected Int    @default(0) @map("eggs_collected")
  mortality     Int    @default(0)
  feedUsed      Decimal @default(0) @map("feed_used") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@unique([flockId, date])
  @@map("daily_production")
}

model Vaccination {
  id            Int       @id @default(autoincrement())
  flockId       Int       @map("flock_id")
  vaccineName   String    @map("vaccine_name")
  scheduledDate DateTime  @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])

  @@map("vaccinations")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  type          String
  category      String?
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  date          DateTime @db.Date
  paymentMethod String?  @map("payment_method")
  reference     String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm Farm  @relation(fields: [farmId], references: [id])
  user User? @relation(fields: [createdBy], references: [id])

  @@map("transactions")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  itemName    String   @map("item_name")
  category    String?
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String   @default("bags")
  unitCost    Decimal  @map("unit_cost") @db.Decimal(10, 2)
  reorderLevel Int     @default(0) @map("reorder_level")
  supplier    String?
  createdAt   DateTime @default(now()) @map("created_at")

  farm  Farm           @relation(fields: [farmId], references: [id])
  logs  InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  inventoryId    Int      @map("inventory_id")
  changeType     String   @map("change_type")
  quantityChange Decimal  @map("quantity_change") @db.Decimal(10, 2)
  reason         String?
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("inventory_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  name        String
  phone       String?
  email       String?
  address     String?
  totalCredit Decimal  @default(0) @map("total_credit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  farm    Farm     @relation(fields: [farmId], references: [id])
  sales   Sale[]
  credits Credit[]

  @@map("customers")
}

model Sale {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  customerId    Int?     @map("customer_id")
  items         Json
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentStatus String   @default("paid") @map("payment_status")
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  saleDate      DateTime @default(now()) @map("sale_date")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm     Farm       @relation(fields: [farmId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  user     User?      @relation(fields: [createdBy], references: [id])
  credits  Credit[]

  @@map("sales")
}

model Credit {
  id         Int      @id @default(autoincrement())
  saleId     Int?     @map("sale_id")
  customerId Int      @map("customer_id")
  farmId     Int      @map("farm_id")
  amountOwed Decimal  @map("amount_owed") @db.Decimal(12, 2)
  amountPaid Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate    DateTime? @map("due_date")
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")

  sale     Sale?    @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  farm     Farm     @relation(fields: [farmId], references: [id])

  @@map("credits")
}

model Worker {
  id        Int       @id @default(autoincrement())
  farmId    Int       @map("farm_id")
  name      String
  phone     String?
  role      String?
  dailyWage Decimal?  @map("daily_wage") @db.Decimal(10, 2)
  status    String    @default("active")
  hiredDate DateTime? @map("hired_date")
  createdBy Int?      @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  farm       Farm         @relation(fields: [farmId], references: [id])
  creator    User?        @relation(fields: [createdBy], references: [id])
  attendance Attendance[]

  @@map("workers")
}


model Attendance {
  id        Int      @id @default(autoincrement())
  workerId  Int      @map("worker_id")
  farmId    Int      @map("farm_id")
  date      DateTime @db.Date
  checkIn   String?  @map("check_in")
  checkOut  String?  @map("check_out")
  status    String   @default("present")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id])
  farm   Farm   @relation(fields: [farmId], references: [id])

  @@map("attendance")
}

model FeedRecipe {
  id         Int      @id @default(autoincrement())
  farmId     Int      @map("farm_id")
  name       String
  ingredients Json?
  costPerBag Decimal? @map("cost_per_bag") @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@map("feed_recipes")
}

model WeatherCache {
  id           Int      @id @default(autoincrement())
  farmId       Int?     @map("farm_id")
  location     String   @default("default")
  date         DateTime @db.Date
  tempMax      Decimal? @map("temperature_max") @db.Decimal(5, 2)
  tempMin      Decimal? @map("temperature_min") @db.Decimal(5, 2)
  rainfallMm   Decimal? @map("rainfall_mm") @db.Decimal(5, 2)
  weatherCode  String?  @map("weather_code")
  forecastJson Json?    @map("forecast_json")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm? @relation(fields: [farmId], references: [id])

  @@unique([location, date])
  @@map("weather_cache")
}

model FarmSetting {
  id           Int      @id @default(autoincrement())
  farmId       Int      @map("farm_id")
  settingKey   String   @map("setting_key")
  settingValue String?  @map("setting_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, settingKey])
  @@map("farm_settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  farmId     Int?     @map("farm_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])
  farm Farm? @relation(fields: [farmId], references: [id])

  @@map("audit_log")
}
