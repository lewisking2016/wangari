# Wangari VPS Backend — Environment Variables

# ─── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wangari_db

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your-secure-random-string-here

# ─── CORS ──────────────────────────────────────────────────
FRONTEND_URL=https://wangari.imeantech.com

# ─── Weather (OpenWeatherMap) ─────────────────────────────
# Get free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key
