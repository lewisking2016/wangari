# Wangari VPS Backend — Environment Variables (template)
#
# Copy to .env and fill in every value. The uptime watchdog
# (scripts/uptime-watch.mjs) checks that every key marked [REQUIRED] exists
# with a non-empty value every 5 minutes and emails admin if not — so keep
# this file complete when you add new keys.

# ─── Server ────────────────────────────────────────────────
PORT=3001                                          # [REQUIRED]
NODE_ENV=production                                # [REQUIRED] "production" enables the ADMIN_JWT_SECRET hard-fail

# ─── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wangari_db   # [REQUIRED]

# ─── JWT ───────────────────────────────────────────────────
# Farmer/user tokens. Rotate = everyone re-logs in.
JWT_SECRET=your-secure-random-string-here          # [REQUIRED] openssl rand -hex 32
# Waadmin (super admin) tokens. SEPARATE secret on purpose.
# If NODE_ENV=production and this is empty the API REFUSES TO START.
ADMIN_JWT_SECRET=another-secure-random-string      # [REQUIRED] openssl rand -hex 32

# ─── CORS ──────────────────────────────────────────────────
FRONTEND_URL=https://wangari.imeantech.com         # [REQUIRED]

# ─── Email (SMTP — preferred path) ─────────────────────────
# Used for verification codes, advisories, notifications and watchdog alerts.
# In production the app runs under PM2 (not dotenv), so these MUST be in .env.
SMTP_HOST=smtp.yourprovider.com                    # [REQUIRED]
SMTP_PORT=587                                      # [REQUIRED]
SMTP_SECURE=false                                  # true = 465 implicit TLS, false = 587 STARTTLS
SMTP_USER=noreply@imeantech.com                    # [REQUIRED]
SMTP_PASS=your-smtp-password                       # [REQUIRED]
EMAIL_FROM="Wangari <noreply@imeantech.com>"       # quote if it contains <>

# ─── Email (fallback provider, optional) ───────────────────
# If SMTP is not configured the app falls back to Resend REST API.
RESEND_API_KEY=
EMAIL_FALLBACK_SHOW_CODE=false                     # dev only: show code in response

# ─── Auth (Google OAuth) ───────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com   # [REQUIRED]

# ─── Cron authentication ───────────────────────────────────
# Shared secret between Vercel Cron and this API. Must match CRON_SECRET on Vercel.
CRON_SECRET=your-cron-shared-secret                # [REQUIRED] openssl rand -hex 24

# ─── Alerts ────────────────────────────────────────────────
ADMIN_ALERT_EMAIL=admin@imeantech.com              # watchdog + admin alerts go here

# ─── Weather (OpenWeatherMap) ──────────────────────────────
# Get free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key

# ─── Payments (Paystack) ───────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ─── PostHog (server-side error/event capture) ─────────────
# Same EU project as the browser SDK; tags backend errors with source=backend
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Sentry (error tracking, Developer tier) ───────────────
# Create project at sentry.io (Node.js/Express). No-op when empty.
SENTRY_DSN=

# ─── AI assistant (optional) ───────────────────────────────
AI_PROVIDER=          # openai | ollama | ...
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
OLLAMA_URL=
