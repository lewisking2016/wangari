# Wangari Farm Management System htaccess Configuration

# Prevent directory listings
Options -Indexes

# Block direct access to Backend directory files from web
RewriteEngine On
RewriteRule ^Backend/config/ - [F,L]
RewriteRule ^Backend/includes/ - [F,L]
RewriteRule ^Backend/storage/ - [F,L]

# Admin access through wangariadmin (security through obscurity)
RewriteRule ^wangariadmin/?$ /wangariadmin.php [L]

# Redirect trailing slashes
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Route root requests to Frontend/index.php
RewriteRule ^$ Frontend/index.php [L]

# Clean URL Routing for main public pages pointing to Frontend
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^about$ Frontend/pages/about.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^services$ Frontend/pages/services.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pricing$ Frontend/pages/pricing.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^contact$ Frontend/pages/contact.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^faq$ Frontend/pages/faq.php [L]

# Clean URL Routing for Auth Pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^login$ Frontend/pages/login.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^register$ Frontend/pages/register.php [L]

# Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
