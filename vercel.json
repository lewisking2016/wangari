{
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://20.164.18.34/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/Frontend/auth/google/login.php",
      "destination": "/Frontend/auth/google/login.html",
      "permanent": false
    },
    {
      "source": "/Frontend/auth/google/callback.php",
      "destination": "/Frontend/auth/google/callback.html",
      "permanent": false
    },
    {
      "source": "/Frontend/pages/pricing.php",
      "destination": "/Frontend/pages/pricing.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/login.php",
      "destination": "/Frontend/pages/login.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/register.php",
      "destination": "/Frontend/pages/register.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/about.php",
      "destination": "/Frontend/pages/about.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/services.php",
      "destination": "/Frontend/pages/services.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/contact.php",
      "destination": "/Frontend/pages/contact.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/faq.php",
      "destination": "/Frontend/pages/faq.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/privacy.php",
      "destination": "/Frontend/pages/privacy.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/terms.php",
      "destination": "/Frontend/pages/terms.html",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/logout.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Frontend/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Frontend/pages/(.*)\\.php",
      "destination": "/Frontend/pages/$1.html",
      "permanent": true
    },
    {
      "source": "/Frontend/admin/(.*)\\.php",
      "destination": "/Frontend/admin/app.html",
      "permanent": false
    },
    {
      "source": "/Frontend/auth/(.*)\\.php",
      "destination": "/Frontend/auth/google/login.html",
      "permanent": false
    },
    {
      "source": "/wangariadmin",
      "destination": "/Frontend/wangariadmin/index.html",
      "permanent": false
    },
    {
      "source": "/wangariadmin/(.*)",
      "destination": "/Frontend/wangariadmin/index.html",
      "permanent": false
    },
    {
      "source": "/Frontend/pages/support.php",
      "destination": "/Frontend/pages/support.html",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/Frontend/pages/support.html",
      "permanent": false
    }
  ]
}
