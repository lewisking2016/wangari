{
  "version": 2,
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/Frontend/assets/(.*)",
      "dest": "/Frontend/assets/$1"
    },
    {
      "src": "/Frontend/images/(.*)",
      "dest": "/Frontend/images/$1"
    },
    {
      "src": "/logo/(.*)",
      "dest": "/logo/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
